# ========================================================
# LLM Provider Configuration
# ========================================================
# Primary: DariaSystem NexusLLM (Qwen, Gemma, Llama, etc.)
NEXUSLLM_API_KEY=nxs_24d0db882c2ae12c0cecb761f9f2c91e71816c12db887a1e816d2b131c9c7077
NEXUSLLM_BASE_URL=https://api-nexusllm.dariasystem.com/v1
NEXUSLLM_MODEL=qwen

# Secondary / Alternative: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Active Provider: "nexusllm" or "gemini"
LLM_PROVIDER=nexusllm

# ========================================================
# Text-to-Speech (TTS) & Podcast Audio Generation
# ========================================================
# Provider: "edge" (Studio Neural voice - ultra realistic) or "nexus" (Piper)
TTS_ENABLED=true
TTS_PROVIDER=edge
# Studio Neural voices: "fa-IR-FaridNeural" (Male) or "fa-IR-DilaraNeural" (Female)
TTS_VOICE=fa-IR-FaridNeural
TTS_MODEL=piper

# Speech-to-Text (Whisper) for podcast / audio ingestion
WHISPER_MODEL=whisper-large-v3

# ========================================================
# Schedule & Publishing Rules
# ========================================================
# Daily run time (UTC, format HH:MM)
SCHEDULE_TIME=07:00

# Maximum posts to process per daily run
DAILY_MAX_POSTS=3

# Quality Audit Threshold (0-100). Posts scoring below this are saved as draft: true
AUDIT_MIN_SCORE=75

# Automatically publish approved posts
AUTO_PUBLISH_APPROVED=true

# ========================================================
# Telegram Channel Broadcast Configuration
# ========================================================
# Set to true to automatically broadcast new posts & podcast MP3 audio to Telegram
TELEGRAM_ENABLED=false
# Bot Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Target Channel Username or ID (e.g., @shirpala_news or -1001234567890)
TELEGRAM_CHANNEL_ID=
# Upload the podcast audio file to the channel
TELEGRAM_SEND_AUDIO=true
# Optional HTTP/SOCKS5 proxy (e.g., socks5://127.0.0.1:1080 or http://127.0.0.1:7890)
TELEGRAM_PROXY=
# Public website base URL
SITE_BASE_URL=https://blog.knowly.ir
