# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model (Current standard: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Daily Run Schedule (Time in UTC, format HH:MM)
SCHEDULE_TIME=07:00

# Maximum number of posts to fetch, translate and publish per day
DAILY_MAX_POSTS=3

# Quality Audit threshold (0 to 100). Posts scoring below this are marked as draft: true
AUDIT_MIN_SCORE=75

# Auto publish approved posts immediately
AUTO_PUBLISH_APPROVED=true
